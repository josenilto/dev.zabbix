{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zabbix-enterprise values",
  "type": "object",
  "required": ["global", "zabbix", "database"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["environment", "cloud"],
      "properties": {
        "environment": { "type": "string", "enum": ["dev", "hml", "prd"] },
        "cloud": { "type": "string", "enum": ["aws", "azure", "gcp", "oci", "onprem", "openshift"] },
        "region": { "type": "string" },
        "clusterName": { "type": "string" },
        "domain": { "type": "string" },
        "podSecurityStandard": { "type": "string", "enum": ["privileged", "baseline", "restricted"] }
      }
    },
    "zabbix": {
      "type": "object",
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "replicaCount": { "type": "integer", "minimum": 1 },
            "podAntiAffinity": { "type": "string", "enum": ["hard", "soft", "none"] }
          }
        },
        "frontend": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "replicaCount": { "type": "integer", "minimum": 1 }
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "type": "string", "enum": ["active", "passive"] }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "internal": { "type": "object" },
        "external": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "engine": { "type": "string", "enum": ["mysql", "postgresql"] }
          }
        }
      }
    },
    "cloudIntegrations": {
      "type": "object",
      "properties": {
        "aws": { "type": "object" },
        "azure": { "type": "object" },
        "gcp": { "type": "object" },
        "oci": { "type": "object" },
        "onprem": { "type": "object" }
      }
    }
  }
}
